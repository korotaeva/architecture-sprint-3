@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml

title ER-диаграмма: Умный дом

' === Сущности ===
entity "Пользователи" as users {
  * user_id : UUID <<PK>>
  --
  * email : VARCHAR(255) <<UNIQUE>>
  * password_hash : TEXT
  * full_name : VARCHAR(100)
  * phone : VARCHAR(20)
  * created_at : TIMESTAMPTZ
  * is_active : BOOLEAN
}

entity "Устройства" as devices {
  * device_id : UUID <<PK>>
  --
  * name : VARCHAR(100)
  * type : ENUM('sensor', 'actuator', 'camera')
  * status : ENUM('online', 'offline', 'error')
  * ip_address : INET
  * last_seen : TIMESTAMPTZ
  * room_id : UUID <<FK>>
}

entity "Комнаты" as rooms {
  * room_id : UUID <<PK>>
  --
  * name : VARCHAR(50)
  * floor : SMALLINT
  * home_id : UUID <<FK>>
}

entity "Дома" as homes {
  * home_id : UUID <<PK>>
  --
  * address : TEXT
  * timezone : VARCHAR(50)
  * owner_id : UUID <<FK>>
}

entity "Сценарии" as scenarios {
  * scenario_id : UUID <<PK>>
  --
  * name : VARCHAR(100)
  * trigger_condition : JSONB
  * actions : JSONB[]
  * is_active : BOOLEAN
  * created_by : UUID <<FK>>
}

entity "Датчики" as sensors {
  * sensor_id : UUID <<PK>>
  --
  * device_id : UUID <<FK>>
  * sensor_type : ENUM('temp', 'humidity', 'motion')
  * last_value : FLOAT
  * last_updated : TIMESTAMPTZ
}

' === Связи ===
users ||--o{ homes : "Владеет"
homes ||--o{ rooms : "Содержит"
rooms ||--o{ devices : "Размещены"
devices ||--|| sensors : "Имеет"
users ||--o{ scenarios : "Создал"

' === Связи многие-ко-многим ===
users }o--o{ devices : "Доступ"
scenarios }o--o{ devices : "Управляет"

' === Индексы ===
note right of users
  Индексы:
  - idx_email (email)
  - idx_created_at (created_at)
end note
@enduml